<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.subsmanager.gui.controller.DashboardController"
    prefWidth="1100" prefHeight="700"
    style="-fx-background-color: #f4f6f9;">
    <fx:define>
        <ToggleGroup fx:id="typeToggle"/>
    </fx:define>

    <!-- ===== SIDEBAR KIRI ===== -->
    <left>
        <VBox
            prefWidth="220"
            spacing="4"
            style="-fx-background-color: #1a1a2e; -fx-padding: 24;">

            <!-- Logo -->
            <Label text="💳 SubsManager"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;
                          -fx-padding: 0 0 24 0;"/>

            <!-- Menu items -->
            <Button text="🏠  Dashboard"
                    onAction="#showDashboard"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: #4f46e5;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="📋  Langganan Saya"
                    onAction="#showSubscriptions"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="💰  Keuangan"
                    onAction="#showFinancial"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="🪙  Toko Koin"
                    onAction="#showCoinStore"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Info user -->
            <Label fx:id="userEmailLabel"
                   text="user@email.com"
                   style="-fx-text-fill: #aaaacc;
                          -fx-font-size: 11px;"/>

            <!-- Logout -->
            <Button text="🚪  Logout"
                    onAction="#handleLogout"
                    prefWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #ff6b6b;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ===== KONTEN UTAMA ===== -->
    <center>
    	<ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        style="-fx-background-color: transparent;
               -fx-background: transparent;
               -fx-border-color: transparent;">
        <VBox spacing="24" style="-fx-padding: 32;">

            <!-- Header -->
            <VBox spacing="4">
                <Label text="Dashboard"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1a1a2e;"/>
                <Label fx:id="greetingLabel"
                       text="Selamat datang!"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #666666;"/>
            </VBox>

            <!-- Kartu ringkasan -->
            <HBox spacing="16">

                <!-- Kartu 1: Total Langganan -->
                <VBox
                    spacing="8" prefWidth="200" prefHeight="110"
                    style="-fx-background-color: white;
                           -fx-background-radius: 12;
                           -fx-padding: 20;
                           -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="📋 Total Langganan"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="totalSubsLabel"
                           text="0"
                           style="-fx-font-size: 32px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #4f46e5;"/>
                    <Label text="aktif"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>

                <!-- Kartu 2: Pengeluaran Bulanan -->
                <VBox
                    spacing="8" prefWidth="200" prefHeight="110"
                    style="-fx-background-color: white;
                           -fx-background-radius: 12;
                           -fx-padding: 20;
                           -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="💸 Pengeluaran Bulanan"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="monthlyLabel"
                           text="Rp 0"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #e74c3c;"/>
                    <Label text="per bulan"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>

                <!-- Kartu 3: Proyeksi Tahunan -->
                <VBox
                    spacing="8" prefWidth="200" prefHeight="110"
                    style="-fx-background-color: white;
                           -fx-background-radius: 12;
                           -fx-padding: 20;
                           -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="📅 Proyeksi Tahunan"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="yearlyLabel"
                           text="Rp 0"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #f39c12;"/>
                    <Label text="per tahun"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>

                <!-- Kartu 4: Saldo Koin -->
                <VBox
                    spacing="8" prefWidth="200" prefHeight="110"
                    style="-fx-background-color: white;
                           -fx-background-radius: 12;
                           -fx-padding: 20;
                           -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="🪙 Saldo Koin"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="coinLabel"
                           text="0"
                           style="-fx-font-size: 32px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #f39c12;"/>
                    <Label text="koin tersedia"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>
            </HBox>

            <!-- Tabel langganan terakhir -->
            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-padding: 24;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="Langganan Aktif"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Tambah"
                            onAction="#showAddSubscription"
                            style="-fx-background-color: #4f46e5;
                                   -fx-text-fill: white;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;
                                   -fx-padding: 6 14 6 14;"/>
                </HBox>

                <TableView fx:id="subscriptionTable"
                           prefHeight="280"
                           style="-fx-background-color: transparent;
                                  -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colNama"
                                     text="Nama Layanan"
                                     prefWidth="200"/>
                        <TableColumn fx:id="colBiaya"
                                     text="Biaya"
                                     prefWidth="150"/>
                        <TableColumn fx:id="colSiklus"
                                     text="Siklus"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colTanggal"
                                     text="Tgl Tagihan"
                                     prefWidth="120"/>
                        <TableColumn fx:id="colKategori"
                                     text="Kategori"
                                     prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
    </center>
</BorderPane>