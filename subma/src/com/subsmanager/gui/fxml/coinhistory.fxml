<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.subsmanager.gui.controller.CoinHistoryController"
    prefWidth="1100" prefHeight="700"
    style="-fx-background-color: #f4f6f9;">

    <fx:define>
        <ToggleGroup fx:id="filterToggle"/>
    </fx:define>

    <!-- ===== SIDEBAR KIRI ===== -->
    <left>
        <VBox
            prefWidth="220" spacing="4"
            style="-fx-background-color: #1a1a2e; -fx-padding: 24;">

            <Label text="SubsManager"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: white; -fx-padding: 0 0 24 0;"/>

            <Button text="Dashboard"
                    onAction="#showDashboard"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="Langganan Saya"
                    onAction="#showSubscriptions"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="Keuangan"
                    onAction="#showFinancial"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="🪙  Toko Koin"
                    onAction="#showCoinStore"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <!-- AKTIF -->
            <Button text="📜  Riwayat Koin"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: #4f46e5;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="userEmailLabel"
                   text="user@email.com"
                   style="-fx-text-fill: #aaaacc; -fx-font-size: 11px;"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    prefWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #ff6b6b; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ===== KONTEN UTAMA ===== -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #f4f6f9;">

            <!-- Header -->
            <VBox style="-fx-background-color: white;
                         -fx-padding: 24 32 20 32;
                         -fx-border-color: #e8ecf0;
                         -fx-border-width: 0 0 1 0;">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="4">
                        <Label text="Riwayat Koin"
                               style="-fx-font-size: 22px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a2e;"/>
                        <Label fx:id="totalTransaksiLabel"
                               text="0 transaksi"
                               style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Saldo Koin -->
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="Saldo Koin"
                               style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
                        <Label fx:id="coinBalanceLabel"
                               text="0 Koin"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #4f46e5;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Filter Bar -->
            <HBox spacing="12"
                  style="-fx-padding: 16 32 8 32;
                         -fx-background-color: #f4f6f9;">
                <Label text="Filter:"
                       style="-fx-font-size: 13px; -fx-text-fill: #555;
                              -fx-padding: 8 0 0 0;"/>
                <RadioButton fx:id="rbSemua"
                             text="Semua"
                             toggleGroup="$filterToggle"
                             selected="true"
                             style="-fx-font-size: 13px;
                                    -fx-text-fill: #333333;
                                    -fx-padding: 6 14 6 14;
                                    -fx-background-color: white;
                                    -fx-background-radius: 20;
                                    -fx-border-color: #d0d5dd;
                                    -fx-border-radius: 20;
                                    -fx-cursor: hand;"/>
                <RadioButton fx:id="rbTopUp"
                             text="Top Up"
                             toggleGroup="$filterToggle"
                             style="-fx-font-size: 13px;
                                    -fx-text-fill: #333333;
                                    -fx-padding: 6 14 6 14;
                                    -fx-background-color: white;
                                    -fx-background-radius: 20;
                                    -fx-border-color: #d0d5dd;
                                    -fx-border-radius: 20;
                                    -fx-cursor: hand;"/>
                <RadioButton fx:id="rbPenggunaan"
                             text="Penggunaan"
                             toggleGroup="$filterToggle"
                             style="-fx-font-size: 13px;
                                    -fx-text-fill: #333333;
                                    -fx-padding: 6 14 6 14;
                                    -fx-background-color: white;
                                    -fx-background-radius: 20;
                                    -fx-border-color: #d0d5dd;
                                    -fx-border-radius: 20;
                                    -fx-cursor: hand;"/>
            </HBox>

            <!-- Tabel Riwayat -->
            <StackPane VBox.vgrow="ALWAYS"
                       style="-fx-padding: 0 32 24 32;">

                <!-- Label kosong -->
                <Label fx:id="emptyLabel"
                       text="Belum ada transaksi."
                       visible="false" managed="false"
                       style="-fx-font-size: 14px; -fx-text-fill: #aaa;"/>

                <TableView fx:id="historyTable"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 12;
                                  -fx-border-color: #e8ecf0;
                                  -fx-border-radius: 12;">
                    <columns>
                        <TableColumn fx:id="colTanggal"
                                     text="Tanggal"
                                     prefWidth="130"/>
                        <TableColumn fx:id="colKode"
                                     text="Kode Transaksi"
                                     prefWidth="170"/>
                        <TableColumn fx:id="colTipe"
                                     text="Tipe"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colDeskripsi"
                                     text="Deskripsi"
                                     prefWidth="210"/>
                        <TableColumn fx:id="colKoin"
                                     text="Koin"
                                     prefWidth="80"/>
                        <TableColumn fx:id="colHarga"
                                     text="Harga"
                                     prefWidth="110"/>
                        <TableColumn fx:id="colMetode"
                                     text="Metode"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colStatus"
                                     text="Status"
                                     prefWidth="90"/>
                        <TableColumn fx:id="colAksi"
                                     text="Aksi"
                                     prefWidth="80"
                                     sortable="false"/>
                    </columns>
                    <placeholder>
                        <Label text="Belum ada transaksi."
                               style="-fx-text-fill: #aaa;"/>
                    </placeholder>
                </TableView>
            </StackPane>

        </VBox>
    </center>

</BorderPane>
