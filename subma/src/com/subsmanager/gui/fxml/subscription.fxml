<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.subsmanager.gui.controller.SubscriptionController"
    prefWidth="1100" prefHeight="700"
    style="-fx-background-color: #f4f6f9;">
    <fx:define>
        <ToggleGroup fx:id="typeToggle"/>
    </fx:define>

    <!-- ===== SIDEBAR KIRI ===== -->
    <left>
        <VBox
            prefWidth="220" spacing="4"
            style="-fx-background-color: #1a1a2e; -fx-padding: 24;">

            <Label text="💳 SubsManager"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: white; -fx-padding: 0 0 24 0;"/>

            <Button text="🏠  Dashboard"
                    onAction="#showDashboard"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="📋  Langganan Saya"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: #4f46e5;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="💰  Keuangan"
                    onAction="#showFinancial"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="🪙  Toko Koin"
                    onAction="#showCoinStore"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="userEmailLabel"
                   text="user@email.com"
                   style="-fx-text-fill: #aaaacc; -fx-font-size: 11px;"/>

            <Button text="🚪  Logout"
                    onAction="#handleLogout"
                    prefWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #ff6b6b; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ===== KONTEN UTAMA ===== -->
    <center>
    	<ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        style="-fx-background-color: transparent;
               -fx-background: transparent;
               -fx-border-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 32;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <Label text="Langganan Saya"
                           style="-fx-font-size: 24px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Label fx:id="subtitleLabel"
                           text="0 langganan aktif"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: #666666;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Tambah Langganan"
                        onAction="#handleAdd"
                        prefHeight="40"
                        style="-fx-background-color: #4f46e5;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;
                               -fx-padding: 0 20 0 20;"/>
            </HBox>

            <!-- Search & Filter bar -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="🔍  Cari nama layanan..."
                           prefWidth="300" prefHeight="38"
                           style="-fx-background-radius: 8;
                                  -fx-border-radius: 8;
                                  -fx-border-color: #dddddd;
                                  -fx-padding: 0 12 0 12;
                                  -fx-font-size: 13px;"/>
                <ComboBox fx:id="filterCombo"
                          promptText="Semua Kategori"
                          prefWidth="180" prefHeight="38"
                          style="-fx-background-radius: 8;
                                 -fx-font-size: 13px;"/>
                <Button text="Reset"
                        onAction="#handleReset"
                        prefHeight="38"
                        style="-fx-background-color: #eeeeee;
                               -fx-text-fill: #555555;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;
                               -fx-padding: 0 16 0 16;"/>
            </HBox>

            <!-- Tabel -->
            <VBox spacing="0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);"
                  VBox.vgrow="ALWAYS">

                <TableView fx:id="subscriptionTable"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-border-color: transparent;
                                  -fx-padding: 8;">
                    <columns>
                        <TableColumn fx:id="colNama"
                                     text="Nama Layanan"
                                     prefWidth="200"/>
                        <TableColumn fx:id="colBiaya"
                                     text="Biaya (IDR/bln)"
                                     prefWidth="160"/>
                        <TableColumn fx:id="colSiklus"
                                     text="Siklus"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colTanggal"
                                     text="Tgl Tagihan"
                                     prefWidth="120"/>
                        <TableColumn fx:id="colTier"
                                     text="Tier"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colAksi"
                                     text="Aksi"
                                     prefWidth="180"/>
                    </columns>
                    <placeholder>
                        <Label text="Belum ada langganan. Klik '+ Tambah' untuk mulai."
                               style="-fx-text-fill: #999999;
                                      -fx-font-size: 13px;"/>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
    </center>
</BorderPane>