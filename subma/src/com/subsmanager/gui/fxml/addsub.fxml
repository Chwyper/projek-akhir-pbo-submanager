<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.subsmanager.gui.controller.AddSubController"
    prefWidth="1100" prefHeight="700"
    style="-fx-background-color: #f4f6f9;">
    <fx:define>
        <ToggleGroup fx:id="typeToggle"/>
    </fx:define>

    <!-- ===== SIDEBAR KIRI ===== -->
    <left>
        <VBox
            prefWidth="220" spacing="4"
            style="-fx-background-color: #1a1a2e; -fx-padding: 24;">

            <Label text="💳 SubsManager"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: white; -fx-padding: 0 0 24 0;"/>

            <Button text="🏠  Dashboard"
                    onAction="#showDashboard"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="📋  Langganan Saya"
                    onAction="#showSubscriptions"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: #4f46e5;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="💰  Keuangan"
                    onAction="#showFinancial"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="🪙  Toko Koin"
                    onAction="#showCoinStore"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="userEmailLabel"
                   text="user@email.com"
                   style="-fx-text-fill: #aaaacc; -fx-font-size: 11px;"/>

            <Button text="🚪  Logout"
                    onAction="#handleLogout"
                    prefWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #ff6b6b; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ===== KONTEN UTAMA ===== -->
    <center>
    	<ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        style="-fx-background-color: transparent;
               -fx-background: transparent;
               -fx-border-color: transparent;">
        <VBox spacing="24" style="-fx-padding: 32;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="← Kembali"
                        onAction="#showSubscriptions"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #4f46e5;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;"/>
                <Label text="Tambah Langganan Baru"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1a1a2e;"/>
            </HBox>

            <!-- Pilihan tipe langganan -->
            <HBox spacing="16">
                <VBox spacing="8" prefWidth="420"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="Tipe Langganan"
                           style="-fx-font-size: 14px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                   
                    <HBox spacing="12">
                        <RadioButton fx:id="radioPredefined"
					                 text="Dari Katalog"
					                 toggleGroup="$typeToggle"
					                 selected="true"
					                 onAction="#handleTypeChange"
					                 style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
					    <RadioButton fx:id="radioCustom"
					                 text="Custom"
					                 toggleGroup="$typeToggle"
					                 onAction="#handleTypeChange"
					                 style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
					 </HBox>
                </VBox>
            </HBox>

            <!-- Form -->
            <HBox spacing="24" VBox.vgrow="ALWAYS">

                <!-- Form Kiri -->
                <VBox spacing="16" prefWidth="480"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 28;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">

                    <Label text="Detail Langganan"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>

                    <!-- Pilih dari katalog - Search Hybrid -->
                    <VBox fx:id="katalogBox" spacing="6">
                        <Label text="Pilih Layanan"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #333333;"/>

                        <!-- Input pencarian -->
                        <TextField fx:id="serviceSearchField"
                                   promptText="Cari layanan..."
                                   prefHeight="38"
                                   style="-fx-background-radius: 8;
                                          -fx-border-radius: 8;
                                          -fx-border-color: #dddddd;
                                          -fx-padding: 0 12 0 12;
                                          -fx-font-size: 13px;"/>

                        <!-- Daftar saran (muncul saat mengetik) -->
                        <ListView fx:id="serviceListView"
                                  prefHeight="150"
                                  visible="false" managed="false"
                                  style="-fx-background-radius: 8;
                                         -fx-border-radius: 8;
                                         -fx-border-color: #dddddd;
                                         -fx-font-size: 13px;"/>

                        <!-- Chip layanan yang sudah dipilih -->
                        <HBox fx:id="selectedServiceBox"
                              spacing="8" alignment="CENTER_LEFT"
                              visible="false" managed="false"
                              style="-fx-background-color: #eef2ff;
                                     -fx-background-radius: 8;
                                     -fx-padding: 8 12 8 12;">
                            <Label fx:id="selectedServiceLabel"
                                   text=""
                                   style="-fx-font-size: 13px;
                                          -fx-text-fill: #4f46e5;
                                          -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="x"
                                    onAction="#handleClearService"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #4f46e5;
                                           -fx-font-size: 12px;
                                           -fx-cursor: hand;
                                           -fx-padding: 0 4 0 4;"/>
                        </HBox>
                    </VBox>

                    <!-- Custom nama (muncul saat mode Custom) -->
                    <VBox fx:id="customNamaBox" spacing="6"
                          managed="false" visible="false">
                        <Label text="Nama Layanan"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #333333;"/>
                        <TextField fx:id="customNamaField"
                                   promptText="contoh: Disney+"
                                   prefHeight="38"
                                   style="-fx-background-radius: 8;
                                          -fx-border-radius: 8;
                                          -fx-border-color: #dddddd;
                                          -fx-padding: 0 12 0 12;
                                          -fx-font-size: 13px;"/>
                        <!-- Warning jika nama sama dengan layanan di katalog -->
                        <Label fx:id="katalogWarningLabel"
                               text=""
                               visible="false" managed="false"
                               style="-fx-text-fill: #e67e22;
                                      -fx-font-size: 11px;
                                      -fx-font-style: italic;
                                      -fx-padding: 0 0 0 2;"/>
                    </VBox>

                    <!-- Tier -->
                    <VBox spacing="6">
                        <Label text="Tier / Paket"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #333333;"/>
                        <ComboBox fx:id="tierCombo"
                                  promptText="Pilih tier..."
                                  prefWidth="Infinity" prefHeight="38"
                                  style="-fx-background-radius: 8;
                                         -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Biaya -->
                    <VBox spacing="6">
                        <Label text="Biaya"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #333333;"/>
                        <HBox spacing="8">
                            <ComboBox fx:id="currencyCombo"
                                      prefWidth="100" prefHeight="38"
                                      style="-fx-background-radius: 8;
                                             -fx-font-size: 13px;"/>
                            <TextField fx:id="biayaField"
                                       promptText="0"
                                       prefHeight="38"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-radius: 8;
                                              -fx-border-radius: 8;
                                              -fx-border-color: #dddddd;
                                              -fx-padding: 0 12 0 12;
                                              -fx-font-size: 13px;"/>
                        </HBox>
                    </VBox>

                    <!-- Siklus tagihan -->
                    <VBox spacing="6">
                        <Label text="Siklus Tagihan"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #333333;"/>
                        <ComboBox fx:id="siklusCombo"
                                  prefWidth="Infinity" prefHeight="38"
                                  style="-fx-background-radius: 8;
                                         -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Tanggal tagihan -->
                    <VBox spacing="6">
                        <Label text="Tanggal Tagihan"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #333333;"/>
                        <DatePicker fx:id="tanggalPicker"
                                    prefWidth="Infinity" prefHeight="38"
                                    style="-fx-background-radius: 8;
                                           -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Custom URL (muncul saat mode Custom) -->
                    <VBox fx:id="customUrlBox" spacing="6"
                          managed="false" visible="false">
                        <Label text="URL Halaman Batal Langganan"
                               style="-fx-font-size: 13px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #333333;"/>
                        <TextField fx:id="customUrlField"
                                   promptText="https://..."
                                   prefHeight="38"
                                   style="-fx-background-radius: 8;
                                          -fx-border-radius: 8;
                                          -fx-border-color: #dddddd;
                                          -fx-padding: 0 12 0 12;
                                          -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Error label -->
                    <Label fx:id="errorLabel" text=""
                           style="-fx-text-fill: #e74c3c;
                                  -fx-font-size: 12px;"/>

                    <!-- Tombol simpan -->
                    <Button text="💾  Simpan Langganan"
                            onAction="#handleSimpan"
                            prefWidth="Infinity" prefHeight="44"
                            style="-fx-background-color: #4f46e5;
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                </VBox>

                <!-- Preview Kanan -->
                <VBox spacing="16" prefWidth="340"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 28;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">

                    <Label text="Preview"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>

                    <VBox spacing="12"
                          style="-fx-background-color: #f8f9ff;
                                 -fx-background-radius: 10;
                                 -fx-padding: 20;">

                        <Label fx:id="previewNama"
                               text="Nama Layanan"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a2e;"/>

                        <Label fx:id="previewTier"
                               text="Tier: -"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #666666;"/>

                        <Label fx:id="previewBiaya"
                               text="Biaya: -"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #666666;"/>

                        <Label fx:id="previewSiklus"
                               text="Siklus: -"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #666666;"/>

                        <Label fx:id="previewTanggal"
                               text="Tgl Tagihan: -"
                               style="-fx-font-size: 13px;
                                      -fx-text-fill: #666666;"/>
                    </VBox>

                    <Label text="ℹ️ Preview akan update otomatis saat kamu mengisi form."
                           wrapText="true"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
    </center>
</BorderPane>