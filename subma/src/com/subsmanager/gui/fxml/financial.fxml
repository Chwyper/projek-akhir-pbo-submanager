<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.subsmanager.gui.controller.FinancialController"
    prefWidth="1100" prefHeight="700"
    style="-fx-background-color: #f4f6f9;">

    <!-- ===== SIDEBAR KIRI ===== -->
    <left>
        <VBox
            prefWidth="220" spacing="4"
            style="-fx-background-color: #1a1a2e; -fx-padding: 24;">

            <Label text="💳 SubsManager"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: white; -fx-padding: 0 0 24 0;"/>

            <Button text="🏠  Dashboard"
                    onAction="#showDashboard"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="📋  Langganan Saya"
                    onAction="#showSubscriptions"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="💰  Keuangan"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: #4f46e5;
                           -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button text="🪙  Toko Koin"
                    onAction="#showCoinStore"
                    prefWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #aaaacc; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="userEmailLabel"
                   text="user@email.com"
                   style="-fx-text-fill: #aaaacc; -fx-font-size: 11px;"/>

            <Button text="🚪  Logout"
                    onAction="#handleLogout"
                    prefWidth="Infinity" prefHeight="40"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #ff6b6b; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ===== KONTEN UTAMA ===== -->
    <center>
    	<ScrollPane
        fitToWidth="true"
        hbarPolicy="NEVER"
        style="-fx-background-color: transparent;
               -fx-background: transparent;
               -fx-border-color: transparent;">
        <VBox spacing="24" style="-fx-padding: 32;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <Label text="Ringkasan Keuangan"
                           style="-fx-font-size: 24px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Label fx:id="lastUpdatedLabel"
                           text="Kurs diperbarui: -"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #999999;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Perbarui Kurs"
                        onAction="#handleRefreshRate"
                        prefHeight="38"
                        style="-fx-background-color: #4f46e5;
                               -fx-text-fill: white;
                               -fx-font-size: 12px;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;
                               -fx-padding: 0 16 0 16;"/>
            </HBox>

            <!-- Kartu ringkasan atas -->
            <HBox spacing="16">

                <!-- Bulanan -->
                <VBox spacing="8" prefWidth="220" prefHeight="120"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="💸 Total Bulanan"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="monthlyTotalLabel"
                           text="Rp 0"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #e74c3c;"/>
                    <Label text="per bulan"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>

                <!-- Tahunan -->
                <VBox spacing="8" prefWidth="220" prefHeight="120"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="📅 Proyeksi Tahunan"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="yearlyTotalLabel"
                           text="Rp 0"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #f39c12;"/>
                    <Label text="per tahun"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>

                <!-- Kurs USD -->
                <VBox spacing="8" prefWidth="220" prefHeight="120"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="💱 Kurs USD → IDR"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="exchangeRateLabel"
                           text="Rp -"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #4f46e5;"/>
                    <Label text="per 1 USD"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>

                <!-- Rata-rata per langganan -->
                <VBox spacing="8" prefWidth="220" prefHeight="120"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                    <Label text="📊 Rata-rata per Langganan"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #666666;"/>
                    <Label fx:id="avgLabel"
                           text="Rp 0"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #27ae60;"/>
                    <Label text="per bulan"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #999999;"/>
                </VBox>
            </HBox>

            <!-- Tabel breakdown per langganan -->
            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-padding: 24;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);"
                  VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT">
                    <Label text="Rincian per Langganan"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a2e;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="📄 Export PDF"
                            onAction="#handleExportPDF"
                            prefHeight="34"
                            style="-fx-background-color: #fee2e2;
                                   -fx-text-fill: #e74c3c;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;
                                   -fx-padding: 0 14 0 14;"/>
                    <Region prefWidth="8"/>
                    <Button text="📊 Export Excel"
                            onAction="#handleExportExcel"
                            prefHeight="34"
                            style="-fx-background-color: #d1fae5;
                                   -fx-text-fill: #059669;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 6;
                                   -fx-cursor: hand;
                                   -fx-padding: 0 14 0 14;"/>
                </HBox>

                <TableView fx:id="breakdownTable"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colNama"
                                     text="Nama Layanan"
                                     prefWidth="200"/>
                        <TableColumn fx:id="colBiayaAsli"
                                     text="Biaya Asli"
                                     prefWidth="150"/>
                        <TableColumn fx:id="colBiayaBulanan"
                                     text="Per Bulan (IDR)"
                                     prefWidth="160"/>
                        <TableColumn fx:id="colBiayaTahunan"
                                     text="Per Tahun (IDR)"
                                     prefWidth="160"/>
                        <TableColumn fx:id="colSiklus"
                                     text="Siklus"
                                     prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Belum ada langganan untuk ditampilkan."
                               style="-fx-text-fill: #999999;
                                      -fx-font-size: 13px;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
    </center>
</BorderPane>