<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.subsmanager.gui.controller.AdminPanelController"
    prefWidth="1100" prefHeight="700"
    style="-fx-background-color: #f4f6f9;">

    <!-- ===== HEADER ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1a1a2e;
                     -fx-padding: 16 32 16 32;">
            <Label text="SubsManager — Admin Panel"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="adminEmailLabel"
                   style="-fx-text-fill: #aaaacc; -fx-font-size: 13px;"/>
            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;
                           -fx-cursor: hand; -fx-padding: 8 16 8 16;"/>
        </HBox>
    </top>

    <!-- ===== TAB PANE ===== -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE"
                 style="-fx-padding: 16 24 24 24;">

            <!-- ══════════════════════════════════ -->
            <!-- TAB 1 — USER                       -->
            <!-- ══════════════════════════════════ -->
            <Tab text="Manajemen User">
                <VBox spacing="12"
                      style="-fx-background-color: #f4f6f9;">

                    <!-- Info bar -->
                    <HBox alignment="CENTER_LEFT" spacing="16"
                          style="-fx-padding: 16 0 8 0;">
                        <Label text="Daftar User"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a2e;"/>
                        <Label fx:id="totalUserLabel"
                               text="0 user terdaftar"
                               style="-fx-text-fill: #888;
                                      -fx-font-size: 13px;"/>
                    </HBox>

                    <!-- Tabel user -->
                    <TableView fx:id="userTable"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 12;
                                      -fx-border-color: #e8ecf0;
                                      -fx-border-radius: 12;">
                        <columns>
                            <TableColumn fx:id="colUserId"
                                         text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colUserEmail"
                                         text="Email" prefWidth="280"/>
                            <TableColumn fx:id="colUserTgl"
                                         text="Tgl Daftar" prefWidth="120"/>
                            <TableColumn fx:id="colUserKoin"
                                         text="Saldo Koin" prefWidth="100"/>
                            <TableColumn fx:id="colUserRole"
                                         text="Role" prefWidth="80"/>
                            <TableColumn fx:id="colUserAksi"
                                         text="Aksi" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="Tidak ada user."
                                   style="-fx-text-fill: #aaa;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ══════════════════════════════════ -->
            <!-- TAB 2 — PEMASUKAN                  -->
            <!-- ══════════════════════════════════ -->
            <Tab text="Pemasukan">
                <VBox spacing="12"
                      style="-fx-background-color: #f4f6f9;">

                    <!-- Kartu ringkasan -->
                    <HBox spacing="16"
                          style="-fx-padding: 16 0 8 0;">
                        <!-- Total Pemasukan -->
                        <VBox spacing="4" prefWidth="220"
                              style="-fx-background-color: white;
                                     -fx-padding: 20;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #e8ecf0;
                                     -fx-border-radius: 12;">
                            <Label text="Total Pemasukan"
                                   style="-fx-text-fill: #888;
                                          -fx-font-size: 12px;"/>
                            <Label fx:id="totalPemasukanLabel"
                                   text="Rp 0"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #27ae60;"/>
                        </VBox>
                        <!-- Total Transaksi -->
                        <VBox spacing="4" prefWidth="180"
                              style="-fx-background-color: white;
                                     -fx-padding: 20;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #e8ecf0;
                                     -fx-border-radius: 12;">
                            <Label text="Total Transaksi"
                                   style="-fx-text-fill: #888;
                                          -fx-font-size: 12px;"/>
                            <Label fx:id="totalTransaksiLabel"
                                   text="0 transaksi"
                                   style="-fx-font-size: 22px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #4f46e5;"/>
                        </VBox>
                    </HBox>

                    <!-- Tabel pemasukan -->
                    <TableView fx:id="pemasukanTable"
                               VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 12;
                                      -fx-border-color: #e8ecf0;
                                      -fx-border-radius: 12;">
                        <columns>
                            <TableColumn fx:id="colPEmail"
                                         text="Email User" prefWidth="220"/>
                            <TableColumn fx:id="colPTanggal"
                                         text="Tanggal" prefWidth="130"/>
                            <TableColumn fx:id="colPKode"
                                         text="Kode Transaksi" prefWidth="170"/>
                            <TableColumn fx:id="colPKoin"
                                         text="Koin" prefWidth="70"/>
                            <TableColumn fx:id="colPHarga"
                                         text="Harga" prefWidth="110"/>
                            <TableColumn fx:id="colPMetode"
                                         text="Metode" prefWidth="100"/>
                            <TableColumn fx:id="colPStatus"
                                         text="Status" prefWidth="90"/>
                        </columns>
                        <placeholder>
                            <Label text="Belum ada transaksi."
                                   style="-fx-text-fill: #aaa;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ══════════════════════════════════ -->
            <!-- TAB 3 — KATALOG                    -->
            <!-- ══════════════════════════════════ -->
            <Tab text="Katalog Subscription">
                <VBox spacing="16"
                      style="-fx-background-color: #f4f6f9;">

                    <!-- Baris atas: Services | Tiers -->
                    <HBox spacing="16" VBox.vgrow="ALWAYS"
                          style="-fx-padding: 16 0 0 0;">

                        <!-- Kolom kiri: Services -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="Daftar Layanan"
                                   style="-fx-font-size: 14px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>

                            <TableView fx:id="serviceTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="280"
                                       style="-fx-background-color: white;
                                              -fx-background-radius: 10;
                                              -fx-border-color: #e8ecf0;
                                              -fx-border-radius: 10;">
                                <columns>
                                    <TableColumn fx:id="colSvcNama"
                                                 text="Nama" prefWidth="120"/>
                                    <TableColumn fx:id="colSvcDomain"
                                                 text="Domain" prefWidth="120"/>
                                    <TableColumn fx:id="colSvcKategori"
                                                 text="Kategori" prefWidth="90"/>
                                    <TableColumn fx:id="colSvcCurrency"
                                                 text="Mata Uang" prefWidth="80"/>
                                    <TableColumn fx:id="colSvcAksi"
                                                 text="Aksi" prefWidth="70"/>
                                </columns>
                                <placeholder>
                                    <Label text="Belum ada layanan."
                                           style="-fx-text-fill: #aaa;"/>
                                </placeholder>
                            </TableView>

                            <!-- Form tambah service -->
                            <VBox spacing="8"
                                  style="-fx-background-color: white;
                                         -fx-padding: 16;
                                         -fx-background-radius: 10;
                                         -fx-border-color: #e8ecf0;
                                         -fx-border-radius: 10;">
                                <Label text="Tambah Layanan Baru"
                                       style="-fx-font-weight: bold;
                                              -fx-font-size: 13px;
                                              -fx-text-fill: #333;"/>
                                <GridPane hgap="8" vgap="8">
                                    <TextField fx:id="tfSvcNama"
                                               promptText="Nama layanan"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="0"
                                               prefWidth="140"/>
                                    <TextField fx:id="tfSvcDomain"
                                               promptText="domain.com"
                                               GridPane.columnIndex="1"
                                               GridPane.rowIndex="0"
                                               prefWidth="140"/>
                                    <TextField fx:id="tfSvcCancelUrl"
                                               promptText="URL pembatalan"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="1"
                                               GridPane.columnSpan="2"
                                               prefWidth="290"/>
                                    <TextField fx:id="tfSvcKategori"
                                               promptText="Kategori (misal: Streaming)"
                                               GridPane.columnIndex="0"
                                               GridPane.rowIndex="2"
                                               GridPane.columnSpan="2"
                                               prefWidth="290"/>
                                </GridPane>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Button text="Tambah Layanan"
                                            onAction="#handleTambahService"
                                            style="-fx-background-color: #4f46e5;
                                                   -fx-text-fill: white;
                                                   -fx-background-radius: 8;
                                                   -fx-cursor: hand;
                                                   -fx-padding: 8 16 8 16;"/>
                                    <Label fx:id="labelSvcError"
                                           style="-fx-text-fill: #e74c3c;
                                                  -fx-font-size: 11px;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Kolom kanan: Tiers -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label fx:id="tierHeaderLabel"
                                   text="Tier"
                                   style="-fx-font-size: 14px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1a1a2e;"/>

                            <TableView fx:id="tierTable"
                                       VBox.vgrow="ALWAYS"
                                       prefHeight="280"
                                       style="-fx-background-color: white;
                                              -fx-background-radius: 10;
                                              -fx-border-color: #e8ecf0;
                                              -fx-border-radius: 10;">
                                <columns>
                                    <TableColumn fx:id="colTierNama"
                                                 text="Nama Tier" prefWidth="130"/>
                                    <TableColumn fx:id="colTierDesc"
                                                 text="Deskripsi" prefWidth="180"/>
                                    <TableColumn fx:id="colTierAksi"
                                                 text="Aksi" prefWidth="70"/>
                                </columns>
                                <placeholder>
                                    <Label text="Pilih layanan untuk melihat tier."
                                           style="-fx-text-fill: #aaa;"/>
                                </placeholder>
                            </TableView>

                            <!-- Form tambah tier -->
                            <VBox spacing="8"
                                  style="-fx-background-color: white;
                                         -fx-padding: 16;
                                         -fx-background-radius: 10;
                                         -fx-border-color: #e8ecf0;
                                         -fx-border-radius: 10;">
                                <Label text="Tambah Tier"
                                       style="-fx-font-weight: bold;
                                              -fx-font-size: 13px;
                                              -fx-text-fill: #333;"/>
                                <HBox spacing="8">
                                    <TextField fx:id="tfTierNama"
                                               promptText="Nama tier"
                                               prefWidth="160"/>
                                    <TextField fx:id="tfTierDesc"
                                               promptText="Deskripsi (opsional)"
                                               HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Button text="Tambah Tier"
                                            onAction="#handleTambahTier"
                                            style="-fx-background-color: #4f46e5;
                                                   -fx-text-fill: white;
                                                   -fx-background-radius: 8;
                                                   -fx-cursor: hand;
                                                   -fx-padding: 8 16 8 16;"/>
                                    <Label fx:id="labelTierError"
                                           style="-fx-text-fill: #e74c3c;
                                                  -fx-font-size: 11px;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
	